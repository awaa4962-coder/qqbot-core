ARG BASE_IMAGE=qqfriend-bridge:linux-preview
FROM ${BASE_IMAGE}

USER root
WORKDIR /app

COPY --chown=node:node bridge ./bridge
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node napcat_bridge.mjs daily_summary.mjs ./
COPY --chown=node:node package.json package-lock.json CHANGELOG.md README.md ./
COPY --chown=node:node launcher/QQFriendLauncher/Web ./launcher/QQFriendLauncher/Web
RUN rm -f /app/bridge/features/index.mjs /app/bridge/features/stickers/manifest.mjs

# An offline source overlay must not disguise vulnerable or stale image binaries.
USER node
RUN node scripts/check-dependency-security.mjs
