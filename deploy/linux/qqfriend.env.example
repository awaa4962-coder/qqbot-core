# Copy this file to qqfriend.env and keep permissions at 600.
# Model API keys stay in state/qqfriend/config/.env_* files, not in this file.

TZ=Asia/Shanghai
QQBOT_LISTEN_HOST=127.0.0.1
QQBOT_LISTEN_PORT=16789
QQFRIEND_WEB_CONSOLE=1

QQBOT_NAPCAT_API=http://127.0.0.1:6700
QQBOT_NAPCAT_WS_API=ws://127.0.0.1:3001
QQBOT_NAPCAT_STREAM_REQUIRED=1
QQBOT_NAPCAT_STREAM_CHUNK_BYTES=262144
QQBOT_NAPCAT_STREAM_RETENTION_SECONDS=86400
QQBOT_NAPCAT_STREAM_TIMEOUT_MS=60000

# Set the same long random token in NapCat's OneBot HTTP/WS configuration.
# Prefer state/qqfriend/config/.env_napcat_token over placing it here.
# QQBOT_NAPCAT_TOKEN=replace-with-a-long-random-token

# Optional defense in depth for the browser management API.
# QQFRIEND_ADMIN_TOKEN=replace-with-another-long-random-token

# Runtime allowlists can use environment variables or sibling files in /config.
# QQBOT_SELF_UIN=1000000001
# QQBOT_GROUPS=2000000001,2000000002
# QQBOT_SUMMARY_GROUPS=2000000001
# QQBOT_RESOURCE_GROUPS=2000000001
# QQBOT_FEATURE_GROUPS=2000000001
# QQBOT_STICKER_GROUPS=2000000001
# QQBOT_FRIENDS=3000000001
# QQBOT_JM_USERS=3000000001
# QQBOT_ADMINS=3000000001
# QQBOT_NAMES=夜星,QQFriend,Yexing
