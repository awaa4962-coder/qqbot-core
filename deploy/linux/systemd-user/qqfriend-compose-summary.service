[Unit]
Description=QQFriend Docker daily group summary
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/qqfriend/summary.env
ExecStart=/usr/bin/docker compose --project-directory ${QQFRIEND_COMPOSE_DIR} --env-file ${QQFRIEND_ENV_FILE} -f ${QQFRIEND_COMPOSE_FILE} run --rm --no-deps -T bridge node daily_summary.mjs
Restart=on-failure
RestartSec=120
TimeoutStartSec=35min
UMask=0077
