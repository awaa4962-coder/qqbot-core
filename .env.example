# 夜星 QQ 机器人 - 环境变量配置模板
# 复制为 .env_mimo / .env_ds / .env_tavily / .env_doubao 后填入真实密钥

# MiMo API Key（主力聊天 + 工具调用 + 图片理解）
# 文件: .env_mimo
# 格式: 单行纯文本，无引号，无换行
# 示例: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API Key（私聊 + 兜底）
# 文件: .env_ds
# 格式: 单行纯文本
# 示例: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily Search API Key（联网搜索）
# 文件: .env_tavily
# 格式: 单行纯文本
# 示例: tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 豆包 Vision API Key（图片理解兜底）
# 文件: .env_doubao
# 格式: 单行纯文本
# 示例: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理员 QQ 号（可选）
# 文件: .env_admins 或环境变量 QQBOT_ADMINS
# 格式: 多个 QQ 号用逗号、分号、空格或换行分隔
# 示例: 123456789,987654321

# 机器人可识别名称（可选）
# 环境变量: QQBOT_NAMES
# 格式: 多个名称用逗号、分号、空格或换行分隔
# 示例: 夜星,QQFriend,Yexing

# 机器人自身 QQ 号（必填）
# 环境变量: QQBOT_SELF_UIN
# 文件: .env_self_uin
# 示例: 1000000001

# Bridge / NapCat 跨平台连接（可选）
# Windows 单机默认值不变；Linux 容器部署请参考 deploy/linux/qqfriend.env.example。
# QQBOT_LISTEN_HOST=0.0.0.0
# QQBOT_LISTEN_PORT=16789
# QQBOT_NAPCAT_API=http://127.0.0.1:6700
# QQBOT_NAPCAT_WS_API=ws://127.0.0.1:3001
# QQBOT_NAPCAT_TOKEN=replace-with-a-long-random-token
# 也可把令牌单独写入 .env_napcat_token，禁止提交或打包该文件。
# QQBOT_NAPCAT_STREAM_REQUIRED=0
# QQBOT_NAPCAT_STREAM_CHUNK_BYTES=262144
# QQBOT_NAPCAT_STREAM_RETENTION_SECONDS=86400
# QQBOT_NAPCAT_STREAM_TIMEOUT_MS=60000
# QQFRIEND_WEB_CONSOLE=0

# 配置项说明（在 bridge/config.mjs 中定义）:
#   napcatApi       NapCat OneBot HTTP API 地址 (默认 http://127.0.0.1:6700)
#   napcatWsApi     NapCat OneBot 正向 WebSocket（跨容器传文件时使用）
#   listenHost      桥接器监听地址（默认 0.0.0.0；Linux 建议 127.0.0.1）
#   listenPort      桥接器监听端口 (默认 16789)
#   selfUin         机器人 QQ 号
#   groupWhitelist  QQ 群白名单
#   botBlacklist    QQ 号黑名单（不回复的机器人）
#   friendWhitelist 好友白名单（允许私聊的用户）
#   adminUins       管理员 QQ 号列表（允许 admin/runtime 命令）
# Resource forwarding group whitelist (optional)
# Environment variable: QQBOT_RESOURCE_GROUPS
# Default: same as bridge/config.mjs groupWhitelist
# Format: group IDs separated by comma, semicolon, spaces, or newlines
# Size limit is fixed at 500MB. Files use a temp directory and are deleted after forwarding.
# Example: 2000000001,2000000002

# Private JM user whitelist (optional)
# Environment variable: QQBOT_JM_USERS
# File: .env_jm_users
# Format: QQ IDs separated by comma, semicolon, spaces, or newlines
# Example: 1000000002

# JM encrypted zip password (optional)
# Environment variable: QQBOT_JM_ZIP_PASSWORD
# Default: FS
# Example: FS

# 7-Zip executable path for encrypted JM zip (optional)
# Environment variable: QQBOT_7Z_PATH
# Example: C:\Program Files\7-Zip\7z.exe

# Auto-install Python dependencies for JM downloads when missing (optional)
# Environment variable: QQBOT_JM_AUTO_INSTALL
# Default: 1
# Example: 1

# Fixed jmcomic source path (optional)
# Environment variable: QQBOT_JMCOMIC_SRC
# Default: empty; uses installed jmcomic package, or runtime_deps\jmcomic\src if present.
# Do not point this at Windows Temp unless it is intentionally refreshed.
# Example: C:\path\to\qqfriend\runtime_deps\jmcomic\src

# JM API/mirror domains (optional)
# Environment variable: QQBOT_JM_DOMAINS
# Default: empty; lets jmcomic use its built-in API domain list and auto-update logic.
# Format: comma-separated domains or full https URLs.
# Example: example-api-1.test,example-api-2.test

# Link preview (optional)
# Environment variable: QQBOT_LINK_PREVIEW_ENABLED
# Default: 1
# Example: 1

# Feature command group whitelist (optional)
# Environment variable: QQBOT_FEATURE_GROUPS
# File: .env_feature_groups
# Default: same as groupWhitelist
# Format: group IDs separated by comma, semicolon, spaces, or newlines
# Example: 2000000001,2000000002

# Wordcloud max source messages (optional)
# Environment variable: QQBOT_WORDCLOUD_MAX_MESSAGES
# Default: 800
# Example: 800

# Extra wordcloud stopwords (optional)
# Environment variable: QQBOT_WORDCLOUD_STOPWORDS
# File: .env_wordcloud_stopwords
# Format: words separated by comma, semicolon, spaces, or newlines
# Example: 哈哈,这个,那个

# Legacy hourly profile refresh (optional)
# Environment variable: QQBOT_LEGACY_PROFILE_REFRESH
# Default: disabled. Set to 1 only if you really want hourly legacy profile generation.
# Example: 0

# Meme knowledge learning mode (optional)
# Environment variable: QQBOT_MEME_MODE
# Default: steady
# Options: off (disable learning and use), shadow (learn without using auto entries), steady (normal)
# Example: steady
#
# Periodic web-verified meme updates (optional)
# QQBOT_MEME_AUTO_UPDATE=1
# QQBOT_MEME_UPDATE_INTERVAL_MS=21600000
# QQBOT_MEME_UPDATE_LIMIT=15
# QQBOT_MEME_TREND_API_BASE=https://api-hot.imsyy.top
# QQBOT_MEME_RSSHUB_BASE=
# QQBOT_MEME_MIN_SOURCES=2
# QQBOT_MEME_MIN_EVIDENCE=3
# QQBOT_MEME_EXPIRY_DAYS=90

# QQ favorite sticker replies (optional)
# Favorites are synchronized from NapCat; image files are not stored locally.
# Environment variable: QQBOT_STICKERS_ENABLED (default 1)
# Environment variable: QQBOT_STICKER_PRIVATE (default 1)
# Environment variable: QQBOT_STICKER_MODE (steady / shadow / off)
# Environment variable: QQBOT_STICKER_CHANCE (default 0.10)
# Environment variable: QQBOT_STICKER_STRONG_CHANCE (default 0.25)
# Environment variable: QQBOT_STICKER_COOLDOWN_MS (default 300000)
# Environment variable: QQBOT_STICKER_SYNC_INTERVAL_MS (default 3600000)
# Environment variable: QQBOT_STICKER_FETCH_COUNT (default 100, max 500)
# Environment variable: QQBOT_STICKER_GROUPS
# Environment variable: QQBOT_STICKER_CAPTURE_MODE (off / observe / auto, default observe)
# Environment variable: QQBOT_STICKER_CAPTURE_DAILY_LIMIT (default 20)
# Environment variable: QQBOT_STICKER_CAPTURE_CATALOG_LIMIT (default 300)
# Environment variable: QQBOT_STICKER_CAPTURE_MIN_CONFIDENCE (default 0.82)
# Environment variable: QQBOT_STICKER_CAPTURE_MIN_DISTINCT_SENDERS (default 2)
# Environment variable: QQBOT_STICKER_CAPTURE_QUEUE_LIMIT (default 50)
# File: .env_sticker_groups
# Default groups: same as QQBOT_GROUPS
# Example: QQBOT_STICKER_GROUPS=2000000001,2000000002
# Group capture uses the same allowlist. It stores remote references, perceptual
# hashes and salted sender hashes only. Upload temporary files are deleted
# immediately after QQ cloud-favorite upload succeeds or fails.

# Local console editable non-secret config (optional)
# These can also be stored in sibling files:
#   .env_bot_names, .env_groups, .env_summary_groups, .env_resource_groups,
#   .env_long_groups, .env_friends, .env_bot_blacklist, .env_admins,
#   .env_sticker_groups
# Format: comma, semicolon, spaces, or newlines.
# QQBOT_SELF_UIN=1000000001
# QQBOT_GROUPS=2000000001,2000000002
# QQBOT_SUMMARY_GROUPS=2000000002
# QQBOT_RESOURCE_GROUPS=2000000001,2000000002
# QQBOT_FEATURE_GROUPS=2000000001,2000000002
# QQBOT_STICKER_GROUPS=2000000001,2000000002
# QQBOT_JM_USERS=1000000002
# QQBOT_LONG_GROUPS=2000000003,2000000004
# QQBOT_FRIENDS=3000000001,3000000002
# QQBOT_BLACKLIST=4000000001
# QQBOT_ADMINS=1000000002
# QQBOT_NAMES=夜星,QQFriend,Yexing

# API quick-swap provider secrets
# Provider metadata and task routes are managed by the local console and stored
# in .qqfriend/api-providers.json. Keys are written to .env_api_<provider-id>.
# Do not commit, print, or package .env_api_* files.
# Existing defaults continue to read .env_mimo and .env_ds.
